{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JWT": {
    "Issuer": "https://localhost:8081",
    "Audience": "https://localhost:4000;https://localhost:4200",
    "AccessTokenLife": 15,
    "RefreshTokenLife": 10080
  },
  "CookieKeys": {
    "AccessToken": "jdo9aADS8923",
    "RefreshToken": "Odopvho7881jDa"
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "BackgroundServices": {
    "RefreshTokenCleanupIntervalHours" :  24
  }
}